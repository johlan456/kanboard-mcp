# --- kanboard-mcp server configuration -------------------------------------
# Copy to .env for local runs. This file holds NO Kanboard credentials —
# credentials are per-user and arrive on each request (see README).

# REQUIRED: your Kanboard JSON-RPC endpoint.
KANBOARD_URL=https://kanboard.example.com/jsonrpc.php

# Bind address / port. Keep host on loopback when fronted by a tunnel/proxy.
HOST=127.0.0.1
PORT=8000

# Per-request timeout (seconds) for calls to Kanboard.
KANBOARD_TIMEOUT=30

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
